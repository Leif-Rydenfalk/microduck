+def cmd_withdraw_positive(root, ref, line, entry_sha256, reason, artifact, by):
+    """Append an audited positive-only withdrawal; refuse any trust increase."""
+    res = resolve(root, ref)
+    entries, problems = read_ledger(ledger_path(res))
+    if problems:
+        raise BrokenInput("repair malformed ledger syntax before withdrawing a claim")
+    if not artifact or not by or not reason:
+        raise BrokenInput("--artifact, --by and --reason are required")
+    ap = artifact if os.path.isabs(artifact) else os.path.join(res.dir, artifact)
+    if not os.path.isfile(ap):
+        raise Failed("audit artifact does not exist: %s" % artifact)
+    entry = {"date": today(), "kind": "export", "outcome": "CANNOT DETERMINE",
+             "summary": "Withdraw positive evidence claim on line %s: %s" % (line, reason),
+             "artifact": os.path.relpath(ap, res.dir), "sha256": sha256_of(ap), "by": by,
+             "positive_claim_withdrawal": {"line": line, "entry_sha256": entry_sha256, "reason": reason}}
+    numbered = dict(entry, _line=max([e["_line"] for e in entries] or [0]) + 1)
+    _withdrawn, errors = positive_claim_withdrawals(res, entries + [numbered])
+    if errors:
+        raise BrokenInput("invalid positive withdrawal: %s" % errors)
+    before = compute_trust(res, entries=entries, problems=[])["record"]["tier"]
+    after = compute_trust(res, entries=entries + [numbered], problems=[])["record"]["tier"]
+    stored = try_json(os.path.join(res.dir, "trust.json")) or {}
+    stored_tier = record_of(stored).get("tier") if stored.get("$generated") else None
+    limit = min(before, stored_tier) if stored_tier in ("T0", "T1", "T2", "T3", "T4") else before
+    if after > limit:
+        raise BrokenInput("withdrawal must not increase computed or stored trust (%s -> %s, stored %s)" % (before, after, stored_tier))
     path = append_ledger(res, entry)
     _tp, doc = write_trust(res)
     return res, entry, path, doc
