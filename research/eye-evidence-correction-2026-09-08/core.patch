+def ledger_entry_sha256(entry):
+    """Canonical identity of the complete original row, excluding reader metadata."""
+    payload = {k: v for k, v in entry.items() if k != "_line"}
+    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":"),
+                                     ensure_ascii=False).encode("utf-8")).hexdigest()
+
+
+def positive_claim_withdrawals(res, entries):
+    """Explicit demotion only: exact prior PASS claims, never negative evidence.
+
+    A valid export/CD correction cites a present hash-checked audit artifact.
+    Invalid corrections have no effect and are separately FAIL findings.
+    """
+    withdrawn, problems = {}, []
+    by_line = {e.get("_line"): e for e in entries}
+    for e in entries:
+        correction = e.get("positive_claim_withdrawal")
+        if correction is None:
+            continue
+        line = e.get("_line")
+        try:
+            if e.get("kind") != "export" or e.get("outcome") != "CANNOT DETERMINE":
+                raise ValueError("withdrawal must be export/CANNOT DETERMINE")
+            if not isinstance(correction, dict) or set(correction) != {"line", "entry_sha256", "reason"}:
+                raise ValueError("withdrawal requires exactly line, entry_sha256, reason")
+            target = correction["line"]
+            if type(target) is not int or type(line) is not int or not 0 < target < line:
+                raise ValueError("target must be an earlier positive ledger line")
+            old = by_line.get(target)
+            if not old or old.get("outcome") != "PASS" or old.get("positive_claim_withdrawal"):
+                raise ValueError("only original PASS claims are eligible; FAIL/CD cannot be withdrawn")
+            if target in withdrawn:
+                raise ValueError("target already withdrawn")
+            if correction["entry_sha256"] != ledger_entry_sha256(old):
+                raise ValueError("target entry hash does not match")
+            if not isinstance(correction["reason"], str) or not correction["reason"].strip():
+                raise ValueError("explicit correction reason required")
+            if not e.get("artifact") or not e.get("sha256"):
+                raise ValueError("a hash-pinned audit artifact is required")
+            audit = artifact_path(res, e["artifact"])
+            if not os.path.isfile(audit) or sha256_of(audit) != e["sha256"]:
+                raise ValueError("audit artifact absent or hash changed")
+            withdrawn[target] = {"correction_line": line, "reason": correction["reason"],
+                                 "entry_sha256": correction["entry_sha256"], "audit": e["artifact"]}
+        except (ValueError, TypeError, KeyError, OSError) as exc:
+            problems.append((line, str(exc)))
+    return withdrawn, problems
+
